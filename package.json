{
  "name": "iflow",
  "version": "1.1.0",
  "description": "iFlow - orquestrador de agentes de IA",
  "main": "./out/main/index.js",
  "author": "Eliandro",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.minicurso.iflow",
    "productName": "iFlow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "resources/icon.png",
    "files": [
      "out/**",
      "agents.json",
      "skills/**",
      "resources/**",
      "package.json",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/prebuilds/darwin-*/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-v${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "resources/icons",
      "category": "Development",
      "desktop": {
        "Name": "iFlow",
        "Comment": "Spatial 2D Canvas workspace running terminals and AI agents"
      }
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "extraFiles": [
      {
        "from": "agents.json",
        "to": "agents.json"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "hooks",
        "to": "hooks"
      },
      {
        "from": "minicurso/instalar.mjs",
        "to": "instalar.mjs"
      },
      {
        "from": "minicurso/LEIA-ME-LABORATORIO.txt",
        "to": "LEIA-ME.txt"
      },
      {
        "from": "minicurso/projeto-exemplo",
        "to": "projeto-exemplo",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/dist/**"
        ]
      }
    ]
  }
}
