{
  "name": "iflow",
  "version": "1.0.0",
  "description": "Spatial 2D Canvas workspace running terminals and AI agents",
  "main": "./out/main/index.js",
  "author": "Eliandro",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.minicurso.iflow",
    "productName": "iFlow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "resources/icon.png",
    "files": [
      "out/**",
      "agents.json",
      "skills/**",
      "resources/**",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "portable",
        "dir"
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "resources/icons",
      "category": "Development",
      "desktop": {
        "Name": "iFlow",
        "Comment": "Spatial 2D Canvas workspace running terminals and AI agents"
      }
    }
  }
}
